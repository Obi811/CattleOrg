# ===========================================================================
#  CattleOrg – Umgebungskonfiguration (Vorlage)
#  Kopiere diese Datei nach `.env` und passe die Werte an.
#  Die Datei `.env` darf NIEMALS ins Git eingecheckt werden (siehe .gitignore).
# ===========================================================================

# --- Anwendung ---------------------------------------------------------------
APP_NAME="CattleOrg"
# Basis-URL-Pfad ab Domain-Root, inkl. abschließendem Slash. Beispiel: "/" oder "/cattleorg/"
BASE_URL="/"
# Umgebung: "production" oder "development".
# Bei "production" werden Fehler NICHT am Bildschirm ausgegeben, sondern geloggt.
APP_ENV="production"
# Wird ueber HTTPS ausgeliefert? true = Secure-Cookies aktiv.
APP_HTTPS="true"

# --- Datenbank ---------------------------------------------------------------
DB_HOST="localhost"
DB_PORT="3306"
DB_NAME="cattleorg"
DB_USER="cattleorg_user"
DB_PASS="bitte_aendern"
DB_CHARSET="utf8mb4"

# --- Sicherheit --------------------------------------------------------------
# Langer Zufallswert, z. B. mit: php -r "echo bin2hex(random_bytes(32));"
APP_KEY="bitte_durch_zufaelligen_64-zeichen-wert_ersetzen"
# Lebensdauer einer Web-Session in Sekunden (Standard: 8 Stunden)
SESSION_LIFETIME="28800"

# --- API ---------------------------------------------------------------------
# Gültigkeit eines API-Tokens in Tagen
API_TOKEN_TTL_DAYS="90"
# Rate-Limit: max. Requests pro Zeitfenster
API_RATE_LIMIT="100"
# Rate-Limit-Fenster in Sekunden (Standard: 15 Minuten)
API_RATE_WINDOW="900"

# --- Push (optional, fuer spaetere Mobile-App) -------------------------------
# Firebase Cloud Messaging – HTTP v1. Pfad zur Service-Account-JSON.
FCM_CREDENTIALS_PATH=""
FCM_PROJECT_ID=""

# --- Apple Push Notification service (APNs) – native iOS-App ------------------
# Aktiviert den APNs-Versand ("true"/"false").
APNS_ENABLED="false"
# Absoluter Pfad zur .p8-Schluesseldatei. MUSS AUSSERHALB von public/ liegen!
# Beispiel: "/home/DEINACCOUNT/apns/AuthKey_ABC1234DEF.p8"
APNS_KEY_PATH=""
# Key ID des .p8-Schluessels (Apple Developer Portal -> Keys).
APNS_KEY_ID=""
# Team ID (Apple Developer Portal, oben rechts / Membership).
APNS_TEAM_ID=""
# Bundle Identifier der iOS-App, z. B. "de.obitron.muhapp".
APNS_BUNDLE_ID=""
# Standard-Umgebung, falls ein Geraet keine angibt: "production" oder "sandbox".
APNS_DEFAULT_ENV="production"
# Optional: expliziter APNs-Host (Host-Override). Leer lassen fuer den
# Standard (api.push.apple.com bzw. api.sandbox.push.apple.com je nach Umgebung).
# Beispiel: "https://api.sandbox.push.apple.com"
APNS_URL=""
# Hinweis: Die Fassade includes/push_sender.php akzeptiert zusaetzlich die
# alternativen Variablennamen APNS_KEY_ID -> KEY_ID, APNS_TEAM_ID -> TEAM_ID,
# APNS_BUNDLE_ID -> BUNDLE_ID (falls in anderer Schreibweise gesetzt).
